{
  "name": "formuladota-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:gen-types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/database.ts",
    "gen:heroes": "npx tsx scripts/gen-heroes.ts",
    "gen:items": "npx tsx scripts/gen-items.ts",
    "gen:abilities": "npx tsx scripts/gen-abilities.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy && bash scripts/verificar-no-ar.sh",
    "cf:verificar": "bash scripts/verificar-no-ar.sh",
    "loja:e2e": "node scripts/loja/e2e.mjs && node scripts/loja/e2e-fila.mjs && node scripts/loja/e2e-fila-saidas.mjs && node scripts/loja/e2e-fila-cortesia.mjs",
    "loja:live-auto": "node scripts/loja/verificar-live-automatica.mjs",
    "battlepass:e2e": "node scripts/battlepass/e2e.mjs",
    "sala:latencia": "node scripts/sala/latencia.mjs",
    "sala:tela": "node scripts/sala/tela-fluida.mjs",
    "sala:e2e": "node scripts/sala/e2e.mjs",
    "sala:realtime": "node scripts/sala/conferir-realtime.mjs",
    "sala:mutacao": "node scripts/sala/mutacao.mjs",
    "sala:capturas": "node scripts/sala/capturas.mjs",
    "sala:producao": "node scripts/sala/conferir-producao.mjs",
    "sala:arquivos-voz": "node scripts/sala/arquivos-voz.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@mercadopago/sdk-react": "1.0.7",
    "@next/third-parties": "^16.2.4",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@sapphi-red/web-noise-suppressor": "0.4.2",
    "@stripe/stripe-js": "^9.9.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tsparticles/engine": "^4.0.5",
    "@tsparticles/react": "^4.0.5",
    "@tsparticles/slim": "^4.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "lucide-react": "^0.456.0",
    "motion": "^12.40.0",
    "next": "16.4.5",
    "next-intl": "^4.13.0",
    "partytracks": "0.0.56",
    "posthog-js": "^1.240.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.9.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.2",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.0",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4.0.0-beta.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.15.0",
    "eslint-config-next": "16.4.5",
    "pg": "^8.20.0",
    "playwright-core": "1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0-beta.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9",
    "wrangler": "4.151.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "@swc/core"
    ]
  }
}
