# Bot Discord FORMULADOTA — variáveis necessárias

# Token do bot Discord (obtido no Discord Developer Portal)
DISCORD_BOT_TOKEN=

# ID do servidor Discord (guild) onde o bot opera
DISCORD_GUILD_ID=

# Chave interna de autenticação entre plataforma e bot
# Gere com: openssl rand -hex 32
INTERNAL_API_KEY=

# Porta do servidor HTTP interno (padrão: 8080)
PORT=8080

# ID do canal de categoria Discord onde as salas são criadas (opcional)
# Se não definido, cria na raiz do servidor
DISCORD_VOICE_CATEGORY_ID=
