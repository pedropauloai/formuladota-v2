# ============================================================================
# Supabase (Phase 1 — já configurado)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — NUNCA commitar. Usado APENAS em /api/webhooks/* (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Discord (Phase 1 OAuth + Phase 4 bot)
# ============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# URL de instalação do bot — gerada via Discord OAuth URL Generator com scopes
# `bot` + `applications.commands` e permissions=277025474560 (Send Messages,
# Embed Links, Read Message History, Use Slash Commands, Send in Threads).
DISCORD_BOT_INSTALL_URL=

# ============================================================================
# AbacatePay V2 — PIX avulso/fichas (MVP Agent D — coexiste com MP)
# ============================================================================
# Sandbox key tem prefixo abc_dev_; produção tem prefixo abc_prod_
# Pegar em: AbacatePay dashboard → API Keys
# ATENÇÃO: Apenas para compras avulsas de fichas (R$10/ficha). Assinatura mensal
# usa Mercado Pago (ver seção abaixo).
ABACATEPAY_API_KEY=
# Secret HMAC do webhook (configurado ao criar o webhook no dashboard AbacatePay)
# Validação: HMAC-SHA256 base64 no header X-Webhook-Signature
ABACATEPAY_WEBHOOK_SECRET=

# ============================================================================
# Mercado Pago — assinatura mensal HUB R$47/mês (Phase 4 — Pix Automático)
# ============================================================================
# Pegar em: https://www.mercadopago.com.br/developers → Suas credenciais
# Sandbox: prefixo TEST-... | Produção: prefixo APP_USR-...
# IMPORTANTE: usar sandbox para desenvolvimento (MP_ACCESS_TOKEN começando com TEST-)
# O app detecta automaticamente o modo sandbox pelo prefixo do token.
MP_ACCESS_TOKEN=
# Chave pública (necessária se usar Checkout Bricks no frontend — opcional V1)
MP_PUBLIC_KEY=
# Secret do webhook: gerado automaticamente ao salvar URL do webhook no painel MP
# Painel MP → Suas integrações → app → aba Webhooks → salvar URL → copiar secret
# URL a configurar: https://formuladota.com/api/webhooks/mercadopago
# Eventos: payment, subscription_preapproval, subscription_authorized_payment
MP_WEBHOOK_SECRET=
# ID do plano de assinatura (opcional — V1 usa preapproval ad-hoc sem plano)
MP_PREAPPROVAL_PLAN_ID=
# LEGADO (pré-tiers 2026-07-04): mensalidade única R$47. Os preços atuais
# Plus/Premium vivem em src/lib/subscriptions/tiers.ts (mudança = Pedro aprovar).
HUB_PRICE_BRL=47

# ============================================================================
# Stripe — assinaturas LATAM (USD) e EU (EUR); BR segue no Mercado Pago
# ============================================================================
# Teste primeiro com sk_test_...; trocar pra sk_live_... só após validar com
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` + cartão 4242.
STRIPE_SECRET_KEY=
# whsec_... — do `stripe listen` (local) ou do endpoint no dashboard (produção)
# URL a configurar: https://formuladota.com/api/webhooks/stripe
# Eventos: checkout.session.completed, invoice.paid, invoice.payment_failed,
#          customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_...) — reservada pra uso client-side futuro (Bricks/Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs gerados por: STRIPE_SECRET_KEY=sk_... npx tsx scripts/stripe-setup.ts
STRIPE_PRICE_PLUS_USD=
STRIPE_PRICE_PREMIUM_USD=
STRIPE_PRICE_PLUS_EUR=
STRIPE_PRICE_PREMIUM_EUR=

# ============================================================================
# OpenDota (Phase 5 — opcional)
# ============================================================================
OPENDOTA_API_KEY=

# ============================================================================
# Cron de finalização automática de partidas (pg_cron → /api/cron/finalize-matches)
# Segredo compartilhado: MESMO valor aqui (Vercel) e no Supabase Vault (job pg_cron).
# Gerar um valor aleatório forte (ex.: openssl rand -hex 32).
# ============================================================================
CRON_SECRET=

# ============================================================================
# CHANGELOG → DISCORD (opcional)
# Webhook do canal 🆕丨atualizacoes. O /novidades espelha automaticamente as
# entradas NOVAS nesse canal (via cron). Sem isto, o changelog fica só no site.
# A URL é impressa pelo `npx tsx bot/src/setup-channels.ts`.
# ============================================================================
CHANGELOG_DISCORD_WEBHOOK_URL=
# Webhooks dos canais 📊 resultados (placar final) e 🔎 fila (partida formada).
# Impressos pelo setup-channels.ts. Sem eles, os posts são no-op.
RESULTS_DISCORD_WEBHOOK_URL=
QUEUE_DISCORD_WEBHOOK_URL=

# ============================================================================
# BOT DISCORD (voz) — serviço Railway SEPARADO do bot Steam
# Usado pelo GATE DE FILA (só busca quem está no canal de voz Buscando Partida)
# e pelas salas dinâmicas de time. FAIL-OPEN: sem estas 3, o gate NÃO bloqueia.
#   DISCORD_BOT_API_URL   = URL pública do bot Discord no Railway (ex.: https://...up.railway.app)
#   DISCORD_BOT_API_KEY   = MESMO valor de INTERNAL_API_KEY do bot Discord (header x-api-key)
#   DISCORD_QUEUE_VOICE_CHANNEL_ID = ID do canal 🎧丨Buscando Partida (impresso pelo setup-channels.ts)
# ============================================================================
DISCORD_BOT_API_URL=
DISCORD_BOT_API_KEY=
DISCORD_QUEUE_VOICE_CHANNEL_ID=

# ============================================================================
# STRATZ (carreira do jogador — conta TODOS os modos, inclusive Turbo)
# Pegar em: https://stratz.com/api — JWT pessoal. NUNCA expor no client.
# ============================================================================
STRATZ_API_KEY=

# ============================================================================
# Liga FormulaDota (ticket) — partidas DA PLATAFORMA
# O bot Steam cria toda sala com as configurações deste ticket; a coleta de
# resultados acontece via API por league_id (independente do jogador).
# ============================================================================
DOTA_LEAGUE_ID=

# ============================================================================
# Steam Web API (Phase 3 — Steam OAuth via OpenID 2.0)
# ============================================================================
# Pegar em: https://steamcommunity.com/dev/apikey
# Pedro precisa logar com a conta Steam dele e cadastrar o domínio
# `formuladota.com` (Hostinger). Em dev, aceitar qualquer domínio funciona —
# o handshake OpenID valida só o realm que o app envia.
# NUNCA expor no client (server-only).
STEAM_WEB_API_KEY=

# ============================================================================
# Resend — email transacional (Phase 2)
# ============================================================================
# Pegar em: Resend dashboard → API Keys
RESEND_API_KEY=
# Enquanto domínio formuladota.com não verificado, usar o default da Resend.
# Quando domínio for verificado, trocar para noreply@formuladota.com
EMAIL_FROM=onboarding@resend.dev

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# DEV ONLY — Tunnel webhook local com smee.io
# ============================================================================
# smee.io é uma bridge HTTP→localhost via Server-Sent Events.
# NÃO precisa de conta. Use os passos abaixo para testar webhook em dev.
#
# Para AbacatePay (fichas avulsas):
# 1) Acesse https://smee.io → "Start a new channel" → URL tipo https://smee.io/abc123
# 2) Configure essa URL no dashboard AbacatePay (sandbox)
# 3) pnpm dlx smee-client --url https://smee.io/SEU-CANAL --target http://localhost:3000/api/webhooks/abacatepay
#
# Para Mercado Pago (assinatura mensal):
# 1) Acesse https://smee.io → "Start a new channel" → URL tipo https://smee.io/xyz456
# 2) Configure essa URL no painel MP: Integrações → Webhooks → URL
# 3) pnpm dlx smee-client --url https://smee.io/SEU-CANAL-MP --target http://localhost:3000/api/webhooks/mercadopago
#
# Salve aqui seus canais smee.io (NÃO são variáveis de env — só referência manual):
# SMEE_CHANNEL_ABACATEPAY=https://smee.io/_______
# SMEE_CHANNEL_MERCADOPAGO=https://smee.io/_______

# --- Analytics (2026-07-03) — todos opcionais; sem key = no-op ---
# GA4 (obrigatorio para conversoes Google Ads): https://analytics.google.com > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# PostHog (funil/retencao, free 1M eventos/mes): https://us.posthog.com > Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
