# ============================================================================
# Supabase (Phase 1 — já configurado)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — NUNCA commitar. Usado APENAS em /api/webhooks/* (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Discord (Phase 1 OAuth + Phase 5 bot)
# ============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_BOT_INSTALL_URL=

# ============================================================================
# Mercado Pago — PIX avulso + Pix Automático (Phase 4 — substitui AbacatePay)
# ============================================================================
# Pegar em: https://www.mercadopago.com.br/developers/panel
# - Production: APP_USR-... (Access Token)
# - Sandbox/Test: TEST-... (Access Token)
# Configurar em "Suas Aplicações" → "Credenciais" → Production OU Test mode.
MP_ACCESS_TOKEN=
# Public key (frontend, opcional pra V1)
MP_PUBLIC_KEY=
# Webhook secret — gerado em "Notificações Webhooks" no painel MP
# Header HMAC: x-signature: ts=...,v1=...
MP_WEBHOOK_SECRET=
# Plan ID (opcional). Se Pedro criar via MCP `mp__mercadopago__*` o ID fica aqui.
# Sem plan ID, criamos preapproval ad-hoc por user.
MP_PREAPPROVAL_PLAN_ID=
# Mensalidade em reais (default 47 se não configurado)
HUB_PRICE_BRL=47

# ============================================================================
# OpenDota (Phase 5 — opcional)
# ============================================================================
OPENDOTA_API_KEY=

# ============================================================================
# Steam Web API (Phase 3 — Steam OAuth via OpenID 2.0)
# ============================================================================
# Pegar em: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# ============================================================================
# Resend — email transacional
# ============================================================================
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# DEV ONLY — Tunnel webhook local com smee.io
# ============================================================================
# smee.io é uma bridge HTTP→localhost via Server-Sent Events.
# NÃO precisa de conta. Use os passos abaixo para testar webhook em dev.
#
# 1) Acesse https://smee.io e clique "Start a new channel" — gera URL única
# 2) Configure essa URL como endpoint webhook no painel Mercado Pago (sandbox)
# 3) Em terminal separado, rode (substituindo SEU-CANAL):
#
#    pnpm dlx smee-client --url https://smee.io/SEU-CANAL --target http://localhost:3000/api/webhooks/mercadopago
#
# 4) Em outro terminal, rode `pnpm dev`
# 5) Pra simular pagamento, use MCP MP `mp__mercadopago__create_test_user` +
#    `mp__mercadopago__add_money_test_user` ou o painel sandbox MP "Simular notificação"
#
# SMEE_CHANNEL_DEV=https://smee.io/_______
