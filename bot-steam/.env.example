# ============================================================================
# Bot Steam FormulaDota — variáveis da SPIKE
# Copie este arquivo para `.env` (na mesma pasta) e preencha. NÃO commitar o .env.
# ============================================================================

# Conta-bot Steam DEDICADA (NUNCA sua conta pessoal). Precisa ter Dota 2 na conta.
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=

# Opcional: shared secret do Steam Guard mobile -> login 100% automático (sem digitar código).
# Se deixar VAZIO, a spike faz login interativo e pede o código do Steam Guard no terminal.
STEAM_BOT_SHARED_SECRET=

# SteamID64 (17 dígitos) de um jogador pra testar o convite (ex.: sua conta pessoal).
# Descubra o seu em https://steamid.io  (campo "steamID64").
TEST_INVITE_STEAMID=

# Senha do lobby de teste (qualquer coisa).
LOBBY_PASSWORD=fd-spike

# Região do servidor: 10 = Brasil. (1=US West, 2=US East, 3=Europe West, 5=Singapore)
SERVER_REGION=10

# Ticket de liga: DEIXE 0 na spike (lobby comum não precisa de ticket).
DOTA_LEAGUE_ID=0

# ============================================================================
#  bot-server.js (CONVITE AUTOMÁTICO) — necessário só pro modo serviço
# ============================================================================
# URL do projeto Supabase formuladota (ex.: https://nyvbfdsxjpiwgdroptdi.supabase.co)
SUPABASE_URL=
# A MESMA SUPABASE_SERVICE_ROLE_KEY do .env do site (chave de servidor — nunca expor).
SUPABASE_SERVICE_ROLE_KEY=

# Login HEADLESS (Railway, sem teclado): gere com `npm run token` no PC e cole aqui/no Railway.
# Com ele o bot loga sozinho, sem pedir código de Steam Guard. (No PC local pode ficar vazio.)
STEAM_REFRESH_TOKEN=

# Intervalo de consulta ao Supabase em ms (opcional). Default 5000.
BOT_POLL_MS=5000

# Lock por slot (opcional): o bot move pro pool quem entra no time/slot errado, forçando
# cada jogador ao slot da sua função (1-5) atribuída no matchmaking. Default LIGADO;
# defina "false" pra desligar (kill-switch).
BOT_LOCK_SLOTS=true
